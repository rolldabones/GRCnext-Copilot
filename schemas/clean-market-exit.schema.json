{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rolldabones/GRCnext-Copilot/schemas/clean-market-exit.schema.json",
  "title": "GRCnext™ Clean Market Exit Master Plan",
  "description": "Terminal artifact of the Advisory Tools Suite, emitted by the Clean Market Exit Kit. Merges all upstream tool outputs into one master playbook from T0 (onset or decision) to final exit, with three milestones against the service's tolerance. In degraded standalone mode the prompt caps the verdict at Conditionally Demonstrated; the cap is advisory: neither this schema nor tools/validate.py enforces it, so a human reviewer checks it against inputs_absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "plan_version",
    "market",
    "verdict",
    "inputs_present",
    "inputs_absent",
    "timeline",
    "gaps",
    "tolerance_hours",
    "milestones",
    "status",
    "drill"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.6",
      "description": "Interchange contract version. 2.6 from GRCnext™ Copilot v2.6.0 (18 October 2026). Changes only when a schema changes; migration rules in schemas/README.md."
    },
    "tool": {
      "type": "string",
      "const": "clean_market_exit_kit",
      "description": "Emitting tool identifier."
    },
    "plan_version": {
      "type": "string",
      "description": "ISO 8601 timestamp, Asia/Seoul unless stated otherwise."
    },
    "market": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "Demonstrated",
        "Conditionally Demonstrated",
        "Not Demonstrated"
      ],
      "description": "The suite verdict scale, shared with the Copilot readiness decision (schema 2.6; replaces PASS / PROVISIONAL PASS / FAIL and READY / PROVISIONAL / NOT READY)."
    },
    "inputs_present": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pipes_mapper",
          "switch_registry",
          "exit_prover",
          "treasury_reroute_planner",
          "data_switchboard_planner"
        ]
      }
    },
    "inputs_absent": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pipes_mapper",
          "switch_registry",
          "exit_prover",
          "treasury_reroute_planner",
          "data_switchboard_planner"
        ]
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "vendors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "finance_plan": {
      "type": "object",
      "additionalProperties": true,
      "description": "treasury_reroute_planner payload or empty object."
    },
    "data_plan": {
      "type": "object",
      "additionalProperties": true,
      "description": "data_switchboard_planner payload or empty object."
    },
    "switch_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "switch",
          "when"
        ],
        "properties": {
          "switch": {
            "type": "string"
          },
          "when": {
            "type": "string",
            "description": "Relative to T0."
          },
          "end_state": {
            "type": "string"
          }
        }
      }
    },
    "notifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "to",
          "owner",
          "status"
        ],
        "properties": {
          "to": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "authority": {
            "type": "string",
            "description": "User-supplied authority only; jurisdiction-specific items default to external counsel."
          },
          "status": {
            "type": "string",
            "enum": [
              "Verified",
              "Provisional",
              "Not evidenced",
              "Contradicted",
              "Refuted",
              "Not applicable"
            ],
            "description": "GRCnext™ evidence classification."
          }
        }
      }
    },
    "extended_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "task",
          "status"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "enum": [
              "Legal",
              "Regulatory",
              "Contracts",
              "Communications",
              "HR",
              "Facilities",
              "Other"
            ]
          },
          "task": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Verified",
              "Provisional",
              "Not evidenced",
              "Contradicted",
              "Refuted",
              "Not applicable"
            ],
            "description": "GRCnext™ evidence classification."
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t",
          "step"
        ],
        "properties": {
          "t": {
            "type": "string",
            "description": "Relative to T0, for example T0, T+4h, T+30d."
          },
          "step": {
            "type": "string"
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tolerance_hours": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "description": "The critical service's approved impact tolerance in hours, from the service dossier. Null when not supplied; feasibility is then Unknown."
    },
    "milestones": {
      "type": "array",
      "description": "Exactly three milestones, in order: containment, interim_continuity, final_exit. Elapsed time runs from clock start (onset of disruption) along the critical path; it is not a sum of step estimates where steps run in parallel. Replaces the 72-hour feasibility boolean of schema 2.5.",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "milestone",
          "elapsed_hours",
          "basis",
          "limit_hours",
          "limit_source",
          "within_limit"
        ],
        "properties": {
          "milestone": {
            "type": "string",
            "enum": [
              "containment",
              "interim_continuity",
              "final_exit"
            ]
          },
          "elapsed_hours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Hours from clock start to the milestone. Null when a duration on the critical path is not supplied."
          },
          "basis": {
            "type": "string",
            "enum": [
              "observed",
              "estimated",
              "assumed",
              "unknown"
            ],
            "description": "observed: measured in an exercise or event; estimated: supplied estimate; assumed: assumption the user accepted; unknown: not supplied."
          },
          "limit_hours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "For interim_continuity, equal to tolerance_hours. For final_exit, the limit set by the supplied authority, or null."
          },
          "limit_source": {
            "type": "string",
            "description": "\"impact tolerance\", the supplied clause or decision, or \"none supplied\"."
          },
          "within_limit": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "elapsed_hours <= limit_hours when both are numbers; null when either is null."
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "executed"
      ]
    },
    "drill": {
      "type": "boolean"
    }
  }
}
