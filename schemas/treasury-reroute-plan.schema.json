{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rolldabones/GRCnext-Copilot/schemas/treasury-reroute-plan.schema.json",
  "title": "GRCnext™ Treasury Reroute Plan",
  "description": "Plan emission from the Treasury Reroute Planner advisory tool. Plans and documents only; never records execution of any transfer. Account identifiers masked to last four characters. Consumed by Clean Market Exit Kit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "plan_version",
    "scenario",
    "affected_flows",
    "routes",
    "steps",
    "tolerance_hours",
    "milestones",
    "drill"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.6",
      "description": "Interchange contract version. 2.6 from GRCnext™ Copilot v2.6.0 (18 October 2026). Changes only when a schema changes; migration rules in schemas/README.md."
    },
    "tool": {
      "type": "string",
      "const": "treasury_reroute_planner",
      "description": "Emitting tool identifier."
    },
    "plan_version": {
      "type": "string",
      "description": "ISO 8601 timestamp, Asia/Seoul unless stated otherwise."
    },
    "scenario": {
      "type": "string"
    },
    "affected_flows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flow",
          "primary"
        ],
        "properties": {
          "flow": {
            "type": "string"
          },
          "primary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "institution",
              "status"
            ],
            "properties": {
              "institution": {
                "type": "string",
                "description": "Neutral label unless the user supplied the name."
              },
              "account": {
                "type": "string",
                "description": "Masked to last four characters."
              },
              "status": {
                "type": "string"
              },
              "evidence_status": {
                "type": "string",
                "enum": [
                  "Verified",
                  "Provisional",
                  "Not evidenced",
                  "Contradicted",
                  "Refuted",
                  "Not applicable"
                ],
                "description": "GRCnext™ evidence classification."
              }
            }
          },
          "backup": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "institution",
              "status"
            ],
            "properties": {
              "institution": {
                "type": "string",
                "description": "Neutral label unless the user supplied the name."
              },
              "account": {
                "type": "string",
                "description": "Masked to last four characters."
              },
              "status": {
                "type": "string"
              },
              "evidence_status": {
                "type": "string",
                "enum": [
                  "Verified",
                  "Provisional",
                  "Not evidenced",
                  "Contradicted",
                  "Refuted",
                  "Not applicable"
                ],
                "description": "GRCnext™ evidence classification."
              }
            }
          },
          "switch": {
            "type": [
              "string",
              "null"
            ]
          },
          "approval_required": {
            "type": [
              "string",
              "null"
            ]
          },
          "eta_hours": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "step",
          "owner",
          "status"
        ],
        "properties": {
          "order": {
            "type": "integer"
          },
          "step": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "done",
              "blocked"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Advisory notes only."
      }
    },
    "tolerance_hours": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "description": "The critical service's approved impact tolerance in hours, from the service dossier. Null when not supplied; feasibility is then Unknown."
    },
    "milestones": {
      "type": "array",
      "description": "Exactly three milestones, in order: containment, interim_continuity, final_exit. Elapsed time runs from clock start (onset of disruption) along the critical path; it is not a sum of step estimates where steps run in parallel. Replaces the 72-hour feasibility boolean of schema 2.5.",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "milestone",
          "elapsed_hours",
          "basis",
          "limit_hours",
          "limit_source",
          "within_limit"
        ],
        "properties": {
          "milestone": {
            "type": "string",
            "enum": [
              "containment",
              "interim_continuity",
              "final_exit"
            ]
          },
          "elapsed_hours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Hours from clock start to the milestone. Null when a duration on the critical path is not supplied."
          },
          "basis": {
            "type": "string",
            "enum": [
              "observed",
              "estimated",
              "assumed",
              "unknown"
            ],
            "description": "observed: measured in an exercise or event; estimated: supplied estimate; assumed: assumption the user accepted; unknown: not supplied."
          },
          "limit_hours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "For interim_continuity, equal to tolerance_hours. For final_exit, the limit set by the supplied authority, or null."
          },
          "limit_source": {
            "type": "string",
            "description": "\"impact tolerance\", the supplied clause or decision, or \"none supplied\"."
          },
          "within_limit": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "elapsed_hours <= limit_hours when both are numbers; null when either is null."
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drill": {
      "type": "boolean"
    }
  }
}
