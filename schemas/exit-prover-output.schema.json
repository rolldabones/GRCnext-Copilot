{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rolldabones/GRCnext-Copilot/schemas/exit-prover-output.schema.json",
  "title": "GRCnext™ Exit Prover Proof",
  "description": "Proof emission from the Exit Prover advisory tool. A proof with gaps reported honestly is a valid Not Demonstrated. Consumed by Clean Market Exit Kit. Under Demonstrated the schema checks at least one dependency, every dependency and obligation at Verified or Not applicable and at least one Verified evidence item; it does not check that every material evidence item is Verified, which 03-exit-prover.md s5 requires and human review retains. Otherwise the verdict is Conditionally Demonstrated or Not Demonstrated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "proof_version",
    "scenario",
    "verdict",
    "dependencies",
    "switches",
    "obligations",
    "gaps",
    "tolerance_hours",
    "milestones"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.6",
      "description": "Interchange contract version. 2.6 from GRCnext™ Copilot v2.6.0 (18 October 2026). Changes only when a schema changes; migration rules in schemas/README.md."
    },
    "tool": {
      "type": "string",
      "const": "exit_prover",
      "description": "Emitting tool identifier."
    },
    "proof_version": {
      "type": "string",
      "description": "ISO 8601 timestamp, Asia/Seoul unless stated otherwise."
    },
    "scenario": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "Demonstrated",
        "Conditionally Demonstrated",
        "Not Demonstrated"
      ],
      "description": "The suite verdict scale, shared with the Copilot readiness decision (schema 2.6; replaces PASS / PROVISIONAL PASS / FAIL and READY / PROVISIONAL / NOT READY)."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "exit_action",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "exit_action": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Verified",
              "Provisional",
              "Not evidenced",
              "Contradicted",
              "Refuted",
              "Not applicable"
            ],
            "description": "GRCnext™ evidence classification."
          }
        }
      }
    },
    "switches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "exists",
              "missing"
            ]
          },
          "flipped": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "requested_state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ON",
              "OFF",
              null
            ],
            "description": "Open request from the Switch Registry, if any. A request is not a flipped switch."
          },
          "last_verified": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_verified_state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ON",
              "OFF",
              null
            ]
          }
        }
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation",
          "owner",
          "status"
        ],
        "properties": {
          "obligation": {
            "type": "string"
          },
          "authority": {
            "type": "string",
            "description": "Cited only from user-supplied material; otherwise Unknown / Insufficient data."
          },
          "owner": {
            "type": "string"
          },
          "deadline": {
            "type": "string",
            "description": "Relative to T0, for example T+72h."
          },
          "evidence_required": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Verified",
              "Provisional",
              "Not evidenced",
              "Contradicted",
              "Refuted",
              "Not applicable"
            ],
            "description": "GRCnext™ evidence classification."
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap"
        ],
        "properties": {
          "gap": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "due": {
            "type": "string"
          }
        }
      }
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "verification_status"
        ],
        "properties": {
          "verification_status": {
            "type": "string",
            "enum": [
              "Verified",
              "Provisional",
              "Not evidenced",
              "Contradicted",
              "Refuted",
              "Not applicable"
            ],
            "description": "GRCnext™ evidence classification, per methodology/evidence-standard.md."
          }
        }
      }
    },
    "tolerance_hours": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "description": "The critical service's approved impact tolerance in hours, from the service dossier. Null when not supplied; feasibility is then Unknown."
    },
    "milestones": {
      "type": "array",
      "description": "Exactly three milestones, in order: containment, interim_continuity, final_exit. Elapsed time runs from clock start (onset of disruption) along the critical path; it is not a sum of step estimates where steps run in parallel. Replaces the 72-hour feasibility boolean of schema 2.5.",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "milestone",
          "elapsed_hours",
          "basis",
          "limit_hours",
          "limit_source",
          "within_limit"
        ],
        "properties": {
          "milestone": {
            "type": "string",
            "enum": [
              "containment",
              "interim_continuity",
              "final_exit"
            ]
          },
          "elapsed_hours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Hours from clock start to the milestone. Null when a duration on the critical path is not supplied."
          },
          "basis": {
            "type": "string",
            "enum": [
              "observed",
              "estimated",
              "assumed",
              "unknown"
            ],
            "description": "observed: measured in an exercise or event; estimated: supplied estimate; assumed: assumption the user accepted; unknown: not supplied."
          },
          "limit_hours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "For interim_continuity, equal to tolerance_hours. For final_exit, the limit set by the supplied authority, or null."
          },
          "limit_source": {
            "type": "string",
            "description": "\"impact tolerance\", the supplied clause or decision, or \"none supplied\"."
          },
          "within_limit": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "elapsed_hours <= limit_hours when both are numbers; null when either is null."
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "Demonstrated"
          }
        }
      },
      "then": {
        "properties": {
          "dependencies": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "Verified",
                    "Not applicable"
                  ]
                }
              }
            }
          },
          "obligations": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "Verified",
                    "Not applicable"
                  ]
                }
              }
            }
          },
          "evidence_items": {
            "minItems": 1,
            "contains": {
              "properties": {
                "verification_status": {
                  "const": "Verified"
                }
              },
              "required": [
                "verification_status"
              ]
            }
          }
        },
        "required": [
          "evidence_items"
        ]
      }
    }
  ]
}
