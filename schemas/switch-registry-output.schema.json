{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rolldabones/GRCnext-Copilot/schemas/switch-registry-output.schema.json",
  "title": "GRCnext™ Switch Registry Output",
  "description": "Registry and append-only log emission from the Switch Registry advisory tool. A flip is requested here and recorded as an event; actuation is human and out of scope, and status is the last verified actual state, Unknown while a request is open or an actuation is unconfirmed. Consumed by Exit Prover, Treasury Reroute Planner, Data Switchboard Planner and Clean Market Exit Kit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "registry_version",
    "switches",
    "log",
    "change_log"
  ],
  "properties": {
    "tool": {
      "type": "string",
      "const": "switch_registry",
      "description": "Emitting tool identifier."
    },
    "registry_version": {
      "type": "string",
      "description": "ISO 8601 timestamp, Asia/Seoul unless stated otherwise."
    },
    "switches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "evidence_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable identifier, for example SW-001."
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "on_means": {
            "type": [
              "string",
              "null"
            ],
            "description": "What ON means for this switch, in operational terms."
          },
          "off_means": {
            "type": [
              "string",
              "null"
            ],
            "description": "What OFF means for this switch, in operational terms."
          },
          "status": {
            "type": "string",
            "enum": [
              "ON",
              "OFF",
              "Unknown"
            ],
            "description": "Last verified actual state. Unknown while a request is open or after a failed, partial or unconfirmed actuation."
          },
          "requested_state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ON",
              "OFF",
              null
            ],
            "description": "Desired state of the open request, if any. A request is not an executed flip."
          },
          "last_requested": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 timestamp of the newest requested event."
          },
          "last_executed": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 timestamp of the newest completed event supported by evidence."
          },
          "last_verified": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 timestamp of the newest verified event."
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "linked_pipe_or_exit": {
            "type": [
              "string",
              "null"
            ]
          },
          "clause_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "Governing authority, for example a policy section."
          },
          "trigger_template": {
            "type": [
              "string",
              "null"
            ]
          },
          "approval_required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notify": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "last_used": {
            "type": [
              "string",
              "null"
            ],
            "description": "Historical declared field written by tool version 1.0. Not evidence of execution."
          },
          "drill": {
            "type": "boolean",
            "description": "True while the open request is a drill."
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "Verified",
              "Provisional",
              "Not demonstrated",
              "Contradicted",
              "Refuted",
              "Not applicable"
            ],
            "description": "GRCnext™ evidence classification."
          }
        }
      }
    },
    "log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp",
          "switch_id",
          "action",
          "actor"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "description": "ISO 8601."
          },
          "switch_id": {
            "type": "string"
          },
          "event": {
            "type": "string",
            "enum": [
              "requested",
              "authorized",
              "attempted",
              "completed",
              "failed",
              "verified"
            ],
            "description": "Event type. A row without this field was written by tool version 1.0 and is a declared flip, not evidence of execution."
          },
          "action": {
            "type": "string",
            "enum": [
              "ON->OFF",
              "OFF->ON"
            ],
            "description": "Direction requested or executed."
          },
          "actor": {
            "type": "string"
          },
          "reason_or_incident_id": {
            "type": "string"
          },
          "approvals_recorded": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Recorded verbatim; validity not asserted by the tool."
          },
          "evidence_ref": {
            "type": "string",
            "description": "Evidence item establishing the result; expected on completed, failed and verified events."
          },
          "drill": {
            "type": "boolean"
          }
        }
      }
    },
    "last_flip": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "change_log": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
